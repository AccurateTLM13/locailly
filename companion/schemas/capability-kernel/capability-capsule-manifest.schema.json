{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://locaily.local/schemas/capability-kernel/capability-capsule-manifest.v1.json",
  "title": "Locaily Capability Capsule Manifest Contract",
  "description": "Versioned manifest contract (capability.json) defining a transferable Capability Capsule's identity, portability classification, requirements, entry points, and self-test verification.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "name",
    "version",
    "portability",
    "requirements",
    "entry_points"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "id": { "type": "string", "minLength": 1, "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "version": { "type": "string", "minLength": 1 },
    "portability": {
      "type": "string",
      "enum": ["portable", "bindable", "anchored"]
    },
    "requirements": {
      "type": "object",
      "additionalProperties": false,
      "required": ["os"],
      "properties": {
        "os": {
          "type": "array",
          "items": { "type": "string", "enum": ["win32", "darwin", "linux"] },
          "minItems": 1,
          "uniqueItems": true
        },
        "runtimes": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true
        },
        "min_cpu_cores": { "type": "integer", "minimum": 1 },
        "min_ram_gb": { "type": "number", "minimum": 0 },
        "permissions": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true
        },
        "bindings": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true
        }
      }
    },
    "entry_points": {
      "type": "object",
      "additionalProperties": { "type": "string", "minLength": 1 }
    },
    "self_test": {
      "type": "object",
      "additionalProperties": false,
      "required": ["script"],
      "properties": {
        "script": { "type": "string", "minLength": 1 },
        "timeout_ms": { "type": "integer", "minimum": 100 }
      }
    }
  }
}
