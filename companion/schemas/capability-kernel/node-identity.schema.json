{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://locaily.local/schemas/capability-kernel/node-identity.v1.json",
  "title": "Locaily Node Identity Contract",
  "description": "Versioned contract defining a Locaily installation's identity, configured roles, platform, runtimes, resources, trust boundary, capability inventory, and availability.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "installation_id",
    "node_id",
    "roles",
    "platform",
    "runtimes",
    "resources",
    "availability"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "installation_id": { "type": "string", "minLength": 1 },
    "node_id": { "type": "string", "minLength": 1 },
    "roles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "enum": ["brain", "worker", "hybrid", "storage", "relay", "standby_brain"]
      },
      "uniqueItems": true
    },
    "primary_brain": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["node_id"],
      "properties": {
        "node_id": { "type": "string", "minLength": 1 },
        "endpoint": { "type": "string" }
      }
    },
    "platform": {
      "type": "object",
      "additionalProperties": false,
      "required": ["os", "arch"],
      "properties": {
        "os": { "type": "string", "enum": ["win32", "darwin", "linux"] },
        "arch": { "type": "string", "enum": ["x64", "arm64"] }
      }
    },
    "runtimes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "available"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "version": { "type": "string" },
          "available": { "type": "boolean" }
        }
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cpu_cores", "ram_gb"],
      "properties": {
        "cpu_cores": { "type": "integer", "minimum": 1 },
        "ram_gb": { "type": "number", "minimum": 0.5 },
        "vram_gb": { "type": "number", "minimum": 0 }
      }
    },
    "trust": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tier"],
      "properties": {
        "tier": { "type": "string", "enum": ["trusted_local", "authenticated_relay", "untrusted"] },
        "allow_remote_execution": { "type": "boolean" }
      }
    },
    "capability_inventory": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["capability_id", "version"],
        "properties": {
          "capability_id": { "type": "string", "minLength": 1 },
          "version": { "type": "string", "minLength": 1 }
        }
      }
    },
    "availability": {
      "type": "string",
      "enum": ["online", "busy", "offline"]
    }
  }
}
